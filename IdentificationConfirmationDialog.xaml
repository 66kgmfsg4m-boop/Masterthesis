<Window x:Class="CheckOrderConfirmationFromSupplier.Windows.IdentificationConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stufe 1: Komponenten-Identifikation"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C10"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFB900"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E81123"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#605E5C"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E1E1E1"/>
        
        <DropShadowEffect x:Key="WindowShadow" 
                         BlurRadius="30" 
                         ShadowDepth="0" 
                         Opacity="0.3" 
                         Color="#000000"/>
        
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="{StaticResource SurfaceColor}"
            CornerRadius="12"
            Effect="{StaticResource WindowShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryColor}"
                    CornerRadius="12,12,0,0"
                    Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0"
                            Background="White"
                            Width="50"
                            Height="50"
                            CornerRadius="25"
                            Margin="0,0,16,0">
                        <TextBlock Text="1"
                                  FontSize="28"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource PrimaryColor}"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="STUFE 1"
                                  FontSize="12"
                                  FontWeight="Bold"
                                  Foreground="#E1DFDD"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Komponenten-Identifikation"
                                  FontSize="20"
                                  FontWeight="Bold"
                                  Foreground="White"/>
                    </StackPanel>
                    
                    <Button Grid.Column="2"
                            Content="X"
                            FontSize="16"
                            FontWeight="Bold"
                            Width="32"
                            Height="32"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="Cancel_Click"
                            VerticalAlignment="Top">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="16"
                                                    Width="{TemplateBinding Width}"
                                                    Height="{TemplateBinding Height}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#40FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
            
            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,24,32,24">
                    <!-- PDF Name -->
                    <Border Background="#F3F4F6"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0"
                                   Background="{StaticResource PrimaryColor}"
                                   Width="32"
                                   Height="32"
                                   CornerRadius="4"
                                   Margin="0,0,12,0">
                                <TextBlock Text="PDF"
                                          FontSize="10"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PDF-Datei"
                                          FontSize="11"
                                          Foreground="{StaticResource TextSecondaryColor}"
                                          Margin="0,0,0,4"/>
                                <TextBlock x:Name="pdfNameLabel"
                                          Text="unknown.pdf"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryColor}"
                                          TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                    <!-- Info Text -->
                    <TextBlock Text="Die KI hat folgende Komponenten-Informationen erkannt:"
                              FontSize="13"
                              Foreground="{StaticResource TextSecondaryColor}"
                              Margin="0,0,0,20"/>
                    
                    <!-- Identified Values -->
                    <Border Background="{StaticResource SurfaceColor}"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20"
                            Margin="0,0,0,24">
                        <StackPanel>
                            <!-- Document Type -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="Dokumenttyp"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                
                                <TextBlock Grid.Column="1"
                                          x:Name="docTypeLabel"
                                          Text="DATASHEET"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryColor}"/>
                            </Grid>
                            
                            <Border Height="1"
                                    Background="{StaticResource BorderColor}"
                                    Margin="0,0,0,16"/>
                            
                            <!-- Category -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="Kategorie"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                
                                <TextBlock Grid.Column="1"
                                          x:Name="categoryLabel"
                                          Text="OP Amplifier"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource PrimaryColor}"/>
                            </Grid>
                            
                            <Border Height="1"
                                    Background="{StaticResource BorderColor}"
                                    Margin="0,0,0,16"/>
                            
                            <!-- Component Name -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="Komponenten-Name"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                
                                <TextBlock Grid.Column="1"
                                          x:Name="componentNameLabel"
                                          Text="LM358"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryColor}"/>
                            </Grid>
                            
                            <Border Height="1"
                                    Background="{StaticResource BorderColor}"
                                    Margin="0,0,0,16"/>
                            
                            <!-- Manufacturer -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="Hersteller"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryColor}"/>
                                
                                <TextBlock Grid.Column="1"
                                          x:Name="manufacturerLabel"
                                          Text="Texas Instruments"
                                          FontSize="15"
                                          FontWeight="SemiBold"
                                          Foreground="{StaticResource TextPrimaryColor}"/>
                            </Grid>
                            
                            <Border Height="1"
                                    Background="{StaticResource BorderColor}"
                                    Margin="0,0,0,16"/>
                            
                            <!-- Part Number - NEU: TEXTEINGABEFELD -->
                            <Grid x:Name="partNumberInputGrid" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0"
                                          Text="Herstellernummer*"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryColor}"
                                          VerticalAlignment="Center"/>
                                
                                <StackPanel Grid.Column="1">
                                    <TextBox x:Name="partNumberTextBox"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Padding="12,10"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="2"
                                            Background="White">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    CornerRadius="6">
                                                                <ScrollViewer x:Name="PART_ContentHost"
                                                                            Margin="{TemplateBinding Padding}"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsFocused" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    
                                    <TextBlock Text="Geben Sie die exakte Herstellernummer aus dem Datenblatt ein"
                                              FontSize="11"
                                              Foreground="{StaticResource TextSecondaryColor}"
                                              Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Question -->
                    <TextBlock Text="Sind diese Werte korrekt?"
                              FontSize="15"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryColor}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"/>
                </StackPanel>
            </ScrollViewer>
            
            <!-- Footer Buttons -->
            <Border Grid.Row="2"
                    Background="#F9FAFB"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <Grid x:Name="PART_WindowFooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Cancel Button -->
                    <Button Grid.Column="0"
                            Content="Abbrechen"
                            Style="{StaticResource ModernButton}"
                            Background="Transparent"
                            Foreground="{StaticResource DangerColor}"
                            BorderThickness="2"
                            BorderBrush="{StaticResource DangerColor}"
                            Click="Cancel_Click"
                            HorizontalAlignment="Left"
                            Padding="20,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Correct Button -->
                    <Button Grid.Column="1"
                            Content="Kategorie korrigieren"
                            Style="{StaticResource ModernButton}"
                            Background="Transparent"
                            Foreground="{StaticResource WarningColor}"
                            BorderThickness="2"
                            BorderBrush="{StaticResource WarningColor}"
                            Click="Correct_Click"
                            Margin="0,0,12,0"
                            Padding="20,12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource WarningColor}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <!-- Confirm Button -->
                    <Button Grid.Column="2"
                            Content="Best&#228;tigen"
                            Style="{StaticResource ModernButton}"
                            Background="{StaticResource SuccessColor}"
                            Foreground="White"
                            Click="Confirm_Click"
                            Padding="28,12"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

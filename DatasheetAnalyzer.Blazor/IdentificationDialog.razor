@using Newtonsoft.Json.Linq
@using Newtonsoft.Json

<div class="modal fade @(_showDialog ? "show d-block" : "")" tabindex="-1" style="@(_showDialog ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle me-2" viewBox="0 0 16 16" style="vertical-align: middle;">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                        <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05"/>
                    </svg>
                    Komponenten-Identifikation bestätigen
                </h5>
                <button type="button" class="btn-close btn-close-white" @onclick="OnCancel"></button>
            </div>
            
            <div class="modal-body">
                @if (IdentificationData != null)
                {
                    <div class="card mb-3">
                        <div class="card-header bg-light">
                            <strong>Erkannte Daten</strong>
                        </div>
                        <div class="card-body">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Dokumenttyp:</label>
                                </div>
                                <div class="col-md-8">
                                    <span class="badge @(DocumentType == "COMPONENT" ? "bg-primary" : "bg-secondary")">
                                        @DocumentType
                                    </span>
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Kategorie: *</label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" 
                                           class="form-control" 
                                           @bind="ComponentCategory" 
                                           @bind:event="oninput"
                                           @onchange="OnCategoryChanged"
                                           placeholder="z.B. Resistor, Amplifier, Capacitor" />
                                    <small class="form-text text-muted">
                                        Die Kategorie kann bearbeitet werden, falls sie nicht korrekt erkannt wurde.
                                        @if (CategoryWasChanged)
                                        {
                                            <br/>
                                            <span class="text-warning"><strong>Hinweis:</strong> Kategorie wurde geändert - Part Number Eingabe wird neu bewertet</span>
                                        }
                                    </small>
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Komponentenname:</label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" 
                                           class="form-control" 
                                           @bind="ComponentName" 
                                           readonly />
                                </div>
                            </div>
                            
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Herstellernummer: @(IsSeriesDatasheet ? "*" : "")</label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" 
                                           class="form-control @(IsSeriesDatasheet && string.IsNullOrWhiteSpace(PartNumber) ? "border-warning" : "")" 
                                           @bind="PartNumber" 
                                           @bind:event="oninput"
                                           placeholder="@(IsSeriesDatasheet ? "z.B. AT25640B-SSHL-B, M24C64-WMN6TP" : "Optional: exakte Herstellernummer manuell eintragen")" />
                                    @if (IsSeriesDatasheet)
                                    {
                                        <small class="form-text text-warning d-flex align-items-center gap-2 mt-2">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill" viewBox="0 0 16 16">
                                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                                            </svg>
                                            <span>
                                                <strong>Series Datasheet erkannt!</strong> Dieses Datenblatt enthält mehrere Varianten.
                                                <br/>Bitte geben Sie die <strong>exakte Herstellernummer</strong> ein, um die korrekte Variante zu identifizieren.
                                            </span>
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="form-text text-muted mt-2 d-block">
                                            Falls es sich um ein Serien-Datenblatt handelt, kann die exakte Herstellernummer hier manuell eingetragen werden.
                                        </small>
                                    }
                                </div>
                            </div>
                            
                            <div class="row mb-0">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold">Hersteller:</label>
                                </div>
                                <div class="col-md-8">
                                    <input type="text" 
                                           class="form-control" 
                                           @bind="ManufacturerInfo" 
                                           readonly />
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    @if (ConfidenceLevel == "LOW")
                    {
                        <div class="alert alert-warning d-flex align-items-center" role="alert">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill me-2" viewBox="0 0 16 16">
                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                            </svg>
                            <div>
                                <strong>Niedrige Konfidenz</strong> - Bitte überprüfen Sie die Kategorie sorgfältig.
                            </div>
                        </div>
                    }
                    
                    @if (IsSeriesDatasheet)
                    {
                        <div class="alert alert-info" role="alert">
                            <h6 class="alert-heading d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                                </svg>
                                <span>Series Datasheet erkannt</span>
                            </h6>
                            <p class="mb-2">
                                Dieses Datenblatt enthält <strong>mehrere Komponenten-Varianten</strong> mit unterschiedlichen Spezifikationen.
                            </p>
                            <p class="mb-0">
                                Die Herstellernummer wird verwendet, um die <strong>korrekte Variante</strong> zu identifizieren und
                                die spezifischen Parameter aus dem <strong>Part Number Chart</strong> zu dekodieren.
                            </p>
                        </div>
                    }

                    @if (IsEmiFilterCategory)
                    {
                        <div class="alert alert-info" role="alert">
                            <h6 class="alert-heading d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                                </svg>
                                <span>EMI-Filter erkannt</span>
                            </h6>
                            <p class="mb-2">
                                EMI-Filter-Datenblätter beschreiben <strong>genau eine Komponente</strong> &ndash;
                                es ist <strong>kein Part Number Decoding</strong> erforderlich.
                            </p>
                            <p class="mb-2">
                                Die <strong>Funktion</strong> wird auf einen der folgenden Werte klassifiziert:
                            </p>
                            <ul class="mb-2">
                                <li><code>EMI FILTER</code> (ENTSTÖRFILTER)</li>
                                <li><code>FERRITE BEAD</code> (FERRITPERLE)</li>
                                <li><code>COMMON MODE CHOKE</code> (GLEICHTAKTDROSSEL)</li>
                                <li><code>FEEDTHROUGH FILTER</code> (DURCHFÜHRUNGSFILTER)</li>
                                <li><code>LC FILTER</code></li>
                                <li><code>PI FILTER</code></li>
                                <li><code>POWER LINE FILTER</code> (NETZFILTER)</li>
                                <li><code>SIGNAL LINE FILTER</code> (SIGNALFILTER)</li>
                            </ul>
                            <p class="mb-0 text-muted">
                                <small>Extrahierte Parameter: Impedanz [Ohm] bei Frequenz, Einfuegedaempfung [dB], DC-Widerstand [Ohm], Nennstrom [A], Nennspannung [V], Frequenzbereich, Gehaeusetyp, Hoehe [mm], Oberflaeche</small>
                            </p>
                        </div>
                    }

                    @if (false && IsCoilCategory)
                    {
                        <div class="alert alert-info" role="alert">
                            <h6 class="alert-heading d-flex align-items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-info-circle-fill" viewBox="0 0 16 16">
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/>
                                </svg>
                                <span>Coil / Inductor erkannt</span>
                            </h6>
                            <p class="mb-2">
                                Coil-Datenblätter beschreiben <strong>genau eine Komponente</strong> &ndash;
                                es ist <strong>kein Part Number Decoding</strong> erforderlich.
                            </p>
                            <p class="mb-2">
                                Die <strong>Funktion</strong> wird auf einen der folgenden Werte klassifiziert:
                            </p>
                            <ul class="mb-2">
                                <li><code>INDUCTOR</code> (SPULE)</li>
                                <li><code>INDUCTOR SHIELDED</code> (SPULE GESCHIRMT)</li>
                                <li><code>MULTILAYER CHIP</code></li>
                                <li><code>POWER CHOKE</code> (LEISTUNGSDROSSEL)</li>
                                <li><code>POWER CHOKE SHIELDED</code> (LEISTUNGSDROSSEL GESCHIRMT)</li>
                                <li><code>TUNABLE</code> (ABSTIMMBAR)</li>
                                <li><code>WIDEBAND BIAS CHOKE</code> (BREITBAND DROSSEL)</li>
                                <li><code>WIRE WOUND</code> (DRAHTGEWICKELT)</li>
                            </ul>
                            <p class="mb-0 text-muted">
                                <small>Extrahierte Parameter: Induktivitaet [H], Toleranz [%], DCR [Ohm], Q + Frequenz, f Nom, Isat, Irms, SRF, Gehaeusetyp, Hoehe [mm], Oberflaeche</small>
                            </p>
                        </div>
                    }
                }
            </div>
            
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnCancel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle me-1" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
                    </svg>
                    Abbrechen
                </button>
                <button type="button" 
                        class="btn btn-primary" 
                        @onclick="OnConfirm"
                        disabled="@(string.IsNullOrWhiteSpace(ComponentCategory) || (IsSeriesDatasheet && string.IsNullOrWhiteSpace(PartNumber)))">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-check2-circle me-1" viewBox="0 0 16 16">
                        <path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0"/>
                        <path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.354 6.646a.5.5 0 1 0-.708.708l3 3a.5.5 0 0 0 .708 0z"/>
                    </svg>
                    @(IsSeriesDatasheet ? "Bestätigen & Dekodieren" : "Bestätigen & Analysieren")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public JObject? IdentificationData { get; set; }
    
    [Parameter]
    public EventCallback<JObject> OnConfirmed { get; set; }
    
    [Parameter]
    public EventCallback OnCancelled { get; set; }
    
    [Parameter]
    public bool IsSeriesDatasheet { get; set; }
    
    private bool _showDialog = false;
    
    private string DocumentType = "";
    private string _componentCategory = "";
    private string ComponentName = "";
    private string PartNumber = "";
    private string ManufacturerInfo = "";
    private string ConfidenceLevel = "";
    private string OriginalCategory = "";
    private bool CategoryWasChanged = false;
    
    // ? Property mit Change-Detection
    private string ComponentCategory
    {
        get => _componentCategory;
        set
        {
            if (_componentCategory != value)
            {
                _componentCategory = value;
                CheckIfCategoryChanged();
            }
        }
    }
    
    protected override void OnParametersSet()
    {
        if (IdentificationData != null)
        {
            DocumentType = IdentificationData["DocumentType"]?.Value<string>() ?? "UNKNOWN";
            _componentCategory = IdentificationData["ComponentCategory"]?.Value<string>() ?? "";
            OriginalCategory = _componentCategory; // Speichere Original
            ComponentName = IdentificationData["ComponentName"]?.Value<string>() ?? "";
            PartNumber = IdentificationData["PartNumber"]?.Value<string>() ?? "";
            ManufacturerInfo = IdentificationData["ManufacturerInfo"]?.Value<string>() ?? "";
            ConfidenceLevel = IdentificationData["ConfidenceLevel"]?.Value<string>() ?? "MEDIUM";
            CategoryWasChanged = false;
        }
    }
    
    /// <summary>
    /// Prüft ob Kategorie geändert wurde und ob Part Number Eingabe aktiviert werden soll
    /// </summary>
    private void CheckIfCategoryChanged()
    {
        CategoryWasChanged = !string.Equals(_componentCategory, OriginalCategory, StringComparison.OrdinalIgnoreCase);
        
        if (CategoryWasChanged)
        {
            // Prüfe ob neue Kategorie ein Series Datasheet benötigt (Memory + Interface IC)
            IsSeriesDatasheet = IsSeriesDatasheetCategory(_componentCategory);
        }
    }
    
    /// <summary>
    /// Callback wenn Kategorie-Feld verlassen wird (für robustere Update-Logik)
    /// </summary>
    private void OnCategoryChanged(ChangeEventArgs e)
    {
        CheckIfCategoryChanged();
        StateHasChanged();
    }
    
    /// <summary>
    /// Prüft ob Kategorie-String ein Series Datasheet darstellt (Memory + Interface IC)
    /// </summary>
    private bool IsSeriesDatasheetCategory(string category)
    {
        if (string.IsNullOrWhiteSpace(category))
            return false;
        
        var seriesKeywords = new[]
        {
            // Memory Components
            "Non-Volatile Memory Serial",
            "Non-Volatile Memory Parallel",
            "NV Memory Serial",
            "NV Memory Parallel",
            "EEPROM Serial",
            "EEPROM Parallel",
            "Flash Serial",
            "Flash Parallel",
            "SRAM",
            "Memory",
            // Interface ICs
            "Interface IC"
        };
        
        // ? Coils und EMI-Filter sind explizit KEINE Series Datasheets (genau 1 Komponente / Datenblatt)
        if (IsCoilCategory || IsEmiFilterCategory)
            return false;
        
        return seriesKeywords.Any(keyword =>
            category.Contains(keyword, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// True wenn die aktuelle Kategorie eine Coil/Inductor-Komponente ist.
    /// Coil-Datenblätter enthalten genau eine Komponente -> kein Part Number Decoding.
    /// </summary>
    private bool IsCoilCategory
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_componentCategory))
                return false;

            var coilKeywords = new[]
            {
                "Coil", "Inductor", "Spule", "Choke", "Drossel"
            };

            return coilKeywords.Any(keyword =>
                _componentCategory.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }
    }

    /// <summary>
    /// True wenn die aktuelle Kategorie eine EMI-Filter-Komponente ist.
    /// EMI-Filter-Datenblätter enthalten genau eine Komponente -> kein Part Number Decoding.
    /// </summary>
    private bool IsEmiFilterCategory
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_componentCategory))
                return false;

            var emiFilterKeywords = new[]
            {
                "EMI Filter", "EMI-Filter", "EMIFilter",
                "Entstörfilter", "Entstoerfilter",
                "Ferrite Bead", "Ferritperle",
                "Common Mode Choke", "Gleichtaktdrossel",
                "Feedthrough Filter", "Durchführungsfilter",
                "LC Filter", "PI Filter",
                "Power Line Filter", "Netzfilter",
                "Signal Line Filter", "Signalfilter"
            };

            return emiFilterKeywords.Any(keyword =>
                _componentCategory.Contains(keyword, StringComparison.OrdinalIgnoreCase));
        }
    }
    
    public async Task ShowAsync()
    {
        _showDialog = true;
        StateHasChanged();
        await Task.CompletedTask;
    }
    
    public void Show()
    {
        _showDialog = true;
        StateHasChanged();
    }
    
    private void OnConfirm()
    {
        var updatedData = IdentificationData?.DeepClone() as JObject;
        if (updatedData != null)
        {
            updatedData["ComponentCategory"] = ComponentCategory;
            updatedData["PartNumber"] = PartNumber;
            updatedData["IsSeriesDatasheet"] = IsSeriesDatasheet;
            updatedData["CategoryWasChanged"] = CategoryWasChanged;
        }
        
        _showDialog = false;
        OnConfirmed.InvokeAsync(updatedData);
    }
    
    private void OnCancel()
    {
        _showDialog = false;
        OnCancelled.InvokeAsync();
    }
}

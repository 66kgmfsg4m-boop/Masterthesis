<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
      <!-- 
        AZURE STORAGE CONFIGURATION
        
        Replace YOUR_ACCOUNT_NAME and YOUR_ACCOUNT_KEY with your actual Azure Storage credentials.
        
        To get your credentials:
        1. Open Azure Portal: https://portal.azure.com
        2. Navigate to your Storage Account: storage3csd2rus
        3. Click on "Access keys" in the left menu
        4. Copy the "Connection string" or "Key"
        
        IMPORTANT: After configuring, rename this file to App.config
                   DO NOT commit App.config to Git!
      -->
      <add key="AzureStorage:ConnectionString" 
           value="DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT_NAME;AccountKey=YOUR_ACCOUNT_KEY;EndpointSuffix=core.windows.net"/>
      <add key="AzureStorage:ContainerName" value="data"/>
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

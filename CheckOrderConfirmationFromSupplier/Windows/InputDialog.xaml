<Window x:Class="CheckOrderConfirmationFromSupplier.Windows.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eingabe" 
        Height="600" Width="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="500">
    
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E1E1E1"/>
        
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Prompt Text with ScrollViewer -->
        <Border Grid.Row="0" 
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,2"
                Padding="0,0,0,15"
                Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                <TextBlock x:Name="promptTextBlock" 
                           TextWrapping="Wrap" 
                           FontSize="13"
                           LineHeight="20"
                           Foreground="#1F1F1F"/>
            </ScrollViewer>
        </Border>
        
        <!-- Empty spacer row -->
        <Grid Grid.Row="1"/>
        
        <!-- Input Field - FREE TEXT -->
        <Border Grid.Row="2"
                BorderBrush="{StaticResource PrimaryColor}"
                BorderThickness="2"
                CornerRadius="8"
                Margin="0,0,0,20">
            <TextBox x:Name="inputTextBox"
                     Style="{StaticResource ModernTextBox}"
                     BorderThickness="0"
                     FontSize="16"
                     FontWeight="SemiBold"
                     Padding="12"
                     MinHeight="50"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Center"
                     KeyDown="InputTextBox_KeyDown"
                     AcceptsReturn="False"/>
        </Border>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button Content="Abbrechen" 
                    Width="130" 
                    Height="40" 
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}"
                    Click="CancelButton_Click"/>
            <Button Content="OK" 
                    Width="130" 
                    Height="40"
                    IsDefault="True"
                    Style="{StaticResource ModernButton}"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

# =====================================================================
# .env.example
# ---------------------------------------------------------------------
# Kopiere diese Datei zu .env und trage die tatsaechlichen Werte ein.
# .env ist per .gitignore ausgeschlossen und darf NICHT committet werden.
# docker-compose liest die Datei automatisch beim `docker compose up`.
# =====================================================================

# --- Azure Blob Storage (RemoteConfig: Prompts, azure-config, users) ---
AzureStorage__ConnectionString=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AzureStorage__ContainerName=source

# --- DMS-REST-API (aktuell verwendet) ---
DmsApi__BaseUrl=https://dms-api-prod.cloud.rsint.net
DmsApi__User=<api-user>
DmsApi__Password=<api-password>
DmsApi__ForceRefresh=false
# Optional: Discovery ueber ALL_TABLES ueberspringen (falls User kein Katalog-Recht hat).
# DmsApi__Tables__0=TE_SACHNR
# DmsApi__Tables__1=TE_SACHNR_HW

# --- DMS-Oracle (Legacy, nur falls Backend=Oracle) ---
DmsOracle__Host=amm31.rsint.net
DmsOracle__FailoverHost=amm41.rsint.net
DmsOracle__Port=1521
DmsOracle__ServiceName=ORAMB_RW.rsint.net
DmsOracle__User=<oracle-user>
DmsOracle__Password=<oracle-password>
DmsOracle__Schema=CMSLIB
DmsOracle__TableNamePrefix=TE_SACHNR
DmsOracle__MaterialNumberPrefix=001000

# --- Azure OpenAI (Endpoint / Key / Deployment) ---
# Namen ggf. an eure AzureConfig-Section anpassen.
# AzureOpenAI__Endpoint=https://openai3csd2-rus.openai.azure.com
# AzureOpenAI__ApiKey=<key>
# AzureOpenAI__Deployment=gpt-5-chat
# AzureOpenAI__ApiVersion=2025-01-01-preview

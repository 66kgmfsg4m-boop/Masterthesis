<Window x:Class="CheckOrderConfirmationFromSupplier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CheckOrderConfirmationFromSupplier"
        mc:Ignorable="d"
        Title="Azure AI PDF Analyzer" 
        Height="900" Width="1600"
        MinHeight="700" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F5F7FA">
    
    <Window.Resources>
        <!-- Moderne Farbpalette -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#005A9E"/>
        <SolidColorBrush x:Key="AccentColor" Color="#00BCF2"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C10"/>
        <SolidColorBrush x:Key="WarningColor" Color="#FFB900"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E81123"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryColor" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="TextSecondaryColor" Color="#605E5C"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E1E1E1"/>
        
        <!-- Drop Shadow Effect -->
        <DropShadowEffect x:Key="CardShadow" 
                         BlurRadius="16" 
                         ShadowDepth="2" 
                         Direction="270" 
                         Opacity="0.15" 
                         Color="#000000"/>
        
        <DropShadowEffect x:Key="ButtonShadow" 
                         BlurRadius="8" 
                         ShadowDepth="1" 
                         Direction="270" 
                         Opacity="0.2" 
                         Color="#000000"/>
        
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Toggle Button Style -->
        <Style x:Key="ToggleAnalysisButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card Style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Window.Resources>
    
    <!-- ✅ HAUPTLAYOUT: Verwende Grid mit 2 Spalten (links: Upload, rechts: Ergebnisse) -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="450" MinWidth="350"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="600"/>
        </Grid.ColumnDefinitions>
        
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LINKE SPALTE: Header + Steuerung -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryColor}" 
                    CornerRadius="12" 
                    Padding="20,16"
                    Effect="{StaticResource CardShadow}"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" 
                            Background="White" 
                            Width="40" 
                            Height="40" 
                            CornerRadius="20"
                            Margin="0,0,12,0">
                        <TextBlock Text="📄" 
                                  FontSize="24" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Azure AI" 
                                  FontSize="20" 
                                  FontWeight="Bold" 
                                  Foreground="White"/>
                        <TextBlock Text="PDF Analyzer" 
                                  FontSize="12" 
                                  Foreground="#E1DFDD" 
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Analysis Mode -->
            <Border Grid.Row="1" 
                    Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Analysemodus" 
                              FontSize="14" 
                              FontWeight="SemiBold" 
                              Foreground="{StaticResource TextPrimaryColor}"
                              Margin="0,0,0,12"/>
                    
                    <RadioButton x:Name="orderConfirmationMode"
                                Style="{StaticResource ToggleAnalysisButton}"
                                Content="📋 Auftragsbestätigung"
                                GroupName="AnalysisMode"
                                IsChecked="True"
                                Margin="0,0,0,8"
                                Checked="AnalysisMode_Changed"/>
                    
                    <RadioButton x:Name="datasheetMode"
                                Style="{StaticResource ToggleAnalysisButton}"
                                Content="🔬 Datenblatt"
                                GroupName="AnalysisMode"
                                Checked="AnalysisMode_Changed"/>
                </StackPanel>
            </Border>
            
            <!-- Upload Area -->
            <Border Grid.Row="2" 
                    Style="{StaticResource Card}"
                    Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" 
                            x:Name="dragDropArea"
                            Height="200"
                            BorderThickness="2"
                            BorderBrush="{StaticResource BorderColor}"
                            CornerRadius="8"
                            AllowDrop="True"
                            DragEnter="DragDropArea_DragEnter"
                            DragLeave="DragDropArea_DragLeave"
                            Drop="DragDropArea_Drop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#F9FAFB" Offset="0"/>
                                            <GradientStop Color="#F3F4F6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="uploadIcon"
                                      Text="☁️" 
                                      FontSize="48" 
                                      HorizontalAlignment="Center" 
                                      Margin="0,0,0,12"/>
                        
                            <TextBlock x:Name="uploadText"
                                      Text="PDF hier hineinziehen" 
                                      FontSize="16" 
                                      FontWeight="SemiBold" 
                                      Foreground="{StaticResource TextPrimaryColor}"
                                      HorizontalAlignment="Center"/>
                        
                            <TextBlock Text="oder" 
                                      FontSize="12" 
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      HorizontalAlignment="Center"
                                      Margin="0,8,0,8"/>
                        
                            <Button Content="📁 Datei auswählen" 
                                   Style="{StaticResource ModernButton}"
                                   Click="SelectFileButton_Click"
                                   Padding="20,10"/>
                        </StackPanel>
                    </Border>
                    
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="resetButton" 
                               Content="🔄 Zurücksetzen" 
                               Style="{StaticResource SecondaryButton}"
                               Click="ResetButton_Click" 
                               IsEnabled="False"/>
                    </Grid>
                </Grid>
            </Border>
            
            <!-- Status Bar -->
            <Border Grid.Row="4" 
                    Background="{StaticResource SurfaceColor}"
                    CornerRadius="8"
                    Padding="16,12"
                    Effect="{StaticResource CardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <ProgressBar Grid.Row="0" 
                                x:Name="progressBar" 
                                Height="6" 
                                Visibility="Collapsed" 
                                IsIndeterminate="True"
                                Margin="0,0,0,12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Background" Value="#E1E1E1"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <TextBlock Text="⚡" 
                                  FontSize="16" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <TextBlock x:Name="statusLabel" 
                                  Text="Bereit" 
                                  FontSize="13"
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Border Grid.Row="2" 
                           Background="{StaticResource AccentColor}"
                           CornerRadius="12"
                           Padding="10,6"
                           Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎯" 
                                      FontSize="14" 
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>
                            <TextBlock x:Name="tokenStatsLabel" 
                                      Text="Tokens: 0/0" 
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Foreground="White"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        
        <!-- ✅ GRID SPLITTER: Ermöglicht Größenänderung -->
        <GridSplitter Grid.Column="1" 
                     Width="5" 
                     HorizontalAlignment="Stretch"
                     Background="{StaticResource BorderColor}"
                     ShowsPreview="False"
                     Cursor="SizeWE"/>
        
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RECHTE SPALTE: ANALYSEERGEBNISSE (VOLLBILD) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" 
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Results Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="resultsIcon"
                                  Text="📊" 
                                  FontSize="20" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"/>
                        <TextBlock x:Name="resultsTitle"
                                  Text="Analyseergebnisse" 
                                  FontSize="18" 
                                  FontWeight="SemiBold" 
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="📋 Kopieren" 
                               Style="{StaticResource SecondaryButton}"
                               Click="CopyButton_Click"
                               Padding="16,8"/>
                        <TextBlock x:Name="copiedLabel" 
                                  Text="" 
                                  Foreground="{StaticResource SuccessColor}"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center" 
                                  Margin="12,0,0,0"/>
                    </StackPanel>
                </Grid>
                
                <!-- Results Content - ✅ VOLLBILD -->
                <Border Grid.Row="1" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Background="#FAFBFC">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                 HorizontalScrollBarVisibility="Auto">
                        <TextBox x:Name="jsonResultArea" 
                                IsReadOnly="True" 
                                TextWrapping="NoWrap" 
                                FontFamily="Consolas, Courier New" 
                                FontSize="13" 
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextPrimaryColor}"
                                Padding="20"
                                AcceptsReturn="True"
                                VerticalAlignment="Stretch"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>

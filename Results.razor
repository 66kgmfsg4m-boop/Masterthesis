@page "/results"
@rendermode InteractiveServer
@inject IAnalyzeStateService State
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject DatasheetAnalyzer.Core.Services.IDmsLookupService DmsLookup
@inject DatasheetAnalyzer.Core.Services.IDmsPropertyMappingService DmsPropertyMap
@inject DatasheetAnalyzer.Core.Services.IPdfChatService PdfChat
@inject DatasheetAnalyzer.Core.Services.DatasheetAnalysisService AnalysisService
@implements IDisposable
@using Newtonsoft.Json.Linq

<PageTitle>Ergebnisse - Datasheet Analyzer</PageTitle>

<style>
    /* Rohde & Schwarz Brand Colors */
    :root {
        --rs-blue-header: #003c7e;
        --rs-blue-dark: #002855;
        --rs-blue-medium: #004fa3;
        --rs-cyan: #0099cc;
        --rs-gray-light: #f5f7fa;
        --rs-gray-medium: #e0e5ea;
        --rs-gray-dark: #6c757d;
        --rs-white: #ffffff;
        --rs-success: #28a745;
    }
    
    .results-page {
        background: linear-gradient(180deg, #f5f7fa 0%, #e8ecf1 100%);
        min-height: calc(100vh - 180px);
        padding: 0;
        display: flex;
        flex-direction: column;
        overflow: visible;
    }
    
    .results-header {
        background: linear-gradient(135deg, var(--rs-blue-header) 0%, var(--rs-blue-medium) 100%);
        color: white;
        padding: 1rem 1.5rem;
        border-bottom: 3px solid var(--rs-cyan);
        box-shadow: 0 4px 20px rgba(0, 60, 126, 0.25);
        flex-shrink: 0;
    }
    
    .results-header-content {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }
    
    .results-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: white;
        font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }
    
    .results-title svg {
        color: var(--rs-cyan);
        filter: drop-shadow(0 2px 4px rgba(0, 153, 204, 0.4));
    }
    
    .button-group {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }
    
    .rs-button {
        background: rgba(255, 255, 255, 0.95);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: var(--rs-blue-header);
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
        height: 38px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }
    
    .rs-button svg {
        color: var(--rs-cyan);
    }
    
    .rs-button:hover:not(:disabled) {
        background: white;
        border-color: var(--rs-cyan);
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(0, 153, 204, 0.4);
    }
    
    .rs-button:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    
    .results-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: grid;
        grid-template-columns: 1fr 350px;
        gap: 1.5rem;
        align-items: start;
        flex: 1;
        overflow: visible;
        width: 100%;
    }
    
    .data-panel {
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 60, 126, 0.12);
        border: 2px solid var(--rs-gray-medium);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    
    .panel-header {
        background: linear-gradient(135deg, var(--rs-blue-header) 0%, var(--rs-blue-medium) 100%);
        color: white;
        padding: 0.875rem 1.25rem;
        border-bottom: 3px solid var(--rs-cyan);
        flex-shrink: 0;
    }
    
    .panel-title {
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    
    .panel-title svg {
        color: var(--rs-cyan);
    }
    
    .panel-body {
        padding: 0;
        flex: 1;
        overflow-y: visible;
        min-height: 0;
    }
    
    .data-content {
        padding: 1.25rem;
        font-family: 'Consolas', 'Courier New', monospace;
        font-size: 12.5px;
        line-height: 1.6;
        color: #1a1d20;
        background: linear-gradient(135deg, #f8f9fa 0%, #f0f2f5 100%);
        white-space: pre-wrap;
        word-wrap: break-word;
    }
    
    .status-panel {
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 60, 126, 0.12);
        border: 2px solid var(--rs-gray-medium);
        border-left: 6px solid var(--rs-cyan);
        padding: 1.25rem;
        position: sticky;
        top: 10px;
        height: fit-content;
        max-height: 100%;
        overflow-y: auto;
    }
    
    .status-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 2px solid var(--rs-cyan);
    }
    
    .status-icon {
        color: var(--rs-cyan);
        font-size: 24px;
        flex-shrink: 0;
    }
    
    .status-title {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--rs-blue-header);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0;
    }
    
    .status-item {
        margin-bottom: 1rem;
    }
    
    .status-item:last-child {
        margin-bottom: 0;
    }
    
    .status-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--rs-gray-dark);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 0.4rem;
    }
    
    .status-value {
        padding: 0.625rem 0.875rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #f0f2f5 100%);
        border: 2px solid var(--rs-gray-medium);
        border-radius: 8px;
        font-weight: 600;
        color: var(--rs-blue-header);
        font-size: 0.9rem;
    }
    
    .status-value.highlight {
        background: linear-gradient(135deg, #e7f5ff 0%, #d0ebff 100%);
        border-color: var(--rs-cyan);
        color: var(--rs-blue-header);
    }
    
    .stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }
    
    .stat-card {
        background: linear-gradient(135deg, #f8f9fa 0%, #f0f2f5 100%);
        border: 2px solid var(--rs-gray-medium);
        border-radius: 8px;
        padding: 0.75rem;
        text-align: center;
    }
    
    .stat-label {
        font-size: 0.7rem;
        color: var(--rs-gray-dark);
        margin-bottom: 0.375rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .stat-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--rs-blue-header);
    }
    
    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--rs-gray-dark);
    }
    
    .empty-state svg {
        color: var(--rs-gray-medium);
        margin-bottom: 1rem;
    }
    
    /* Responsive */
    @@media (max-width: 1200px) {
        .results-container {
            grid-template-columns: 1fr;
        }
        
        .status-panel {
            position: static;
        }
    }
    
    /* Scrollbar Styling */
    .panel-body::-webkit-scrollbar {
        width: 10px;
    }
    
    .panel-body::-webkit-scrollbar-track {
        background: var(--rs-gray-light);
    }
    
    .panel-body::-webkit-scrollbar-thumb {
        background: var(--rs-gray-medium);
        border-radius: 5px;
    }
    
    .panel-body::-webkit-scrollbar-thumb:hover {
        background: var(--rs-gray-dark);
    }

    /* DMS Compare Panel */
    .dms-panel {
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 60, 126, 0.12);
        border: 2px solid var(--rs-gray-medium);
        margin-top: 1rem;
        overflow: hidden;
    }

    .dms-panel-header {
        background: linear-gradient(135deg, var(--rs-blue-header) 0%, var(--rs-blue-medium) 100%);
        color: white;
        padding: 0.75rem 1.25rem;
        border-bottom: 3px solid var(--rs-cyan);
    }

    .dms-panel-header h3 {
        margin: 0;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .dms-panel-body {
        padding: 1rem 1.25rem;
        font-size: 0.9rem;
        overflow-x: auto;
    }

    .dms-table-wrapper {
        overflow-x: auto;
        border: 1px solid var(--rs-gray-medium);
        border-radius: 6px;
    }

    .dms-table {
        width: 100%;
        border-collapse: collapse;
        table-layout: auto;
    }

    .dms-table th {
        background: var(--rs-blue-header);
        color: white;
        padding: 8px 12px;
        text-align: left;
        font-weight: 700;
        font-size: 0.85rem;
        white-space: nowrap;
    }

    .dms-table td {
        padding: 8px 12px;
        border-bottom: 1px solid var(--rs-gray-medium);
        vertical-align: top;
        word-break: break-word;
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .dms-cell-diff {
        background: #fff3cd;
        font-weight: 700;
        color: #856404;
    }

    .dms-cell-match {
        background: #d4edda;
        color: #155724;
    }

    .dms-info {
        padding: 10px 14px;
        background: #e7f1fb;
        border-left: 4px solid var(--rs-cyan);
        border-radius: 6px;
        color: var(--rs-blue-header);
        font-weight: 600;
    }

    .dms-error {
        padding: 10px 14px;
        background: #f8d7da;
        border-left: 4px solid #dc3545;
        border-radius: 6px;
        color: #721c24;
        font-weight: 600;
    }

    /* Chatbot Panel */
    .chat-panel {
        background: white;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 60, 126, 0.12);
        border: 2px solid var(--rs-gray-medium);
        margin-top: 1rem;
        overflow: hidden;
    }

    .chat-panel-header {
        background: linear-gradient(135deg, var(--rs-blue-header) 0%, var(--rs-blue-medium) 100%);
        color: white;
        padding: 0.75rem 1.25rem;
        border-bottom: 3px solid var(--rs-cyan);
    }

    .chat-panel-header h3 {
        margin: 0;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
    }

    .chat-panel-body {
        padding: 1rem 1.25rem;
        font-size: 0.9rem;
    }

    .chat-question-input {
        width: 100%;
        padding: 10px 12px;
        border: 2px solid var(--rs-gray-medium);
        border-radius: 6px;
        font-family: inherit;
        font-size: 0.95rem;
        resize: vertical;
        min-height: 70px;
        box-sizing: border-box;
    }

    .chat-question-input:focus {
        outline: none;
        border-color: var(--rs-cyan);
        box-shadow: 0 0 0 3px rgba(0, 153, 204, 0.15);
    }

    .chat-answer-box {
        margin-top: 12px;
        padding: 12px 14px;
        background: linear-gradient(135deg, #f8f9fa 0%, #f0f2f5 100%);
        border-left: 4px solid var(--rs-cyan);
        border-radius: 6px;
        color: #1a1d20;
        white-space: pre-wrap;
        line-height: 1.55;
    }

    .chat-error-box {
        margin-top: 12px;
        padding: 10px 14px;
        background: #f8d7da;
        border-left: 4px solid #dc3545;
        border-radius: 6px;
        color: #721c24;
        font-weight: 600;
    }

    .chat-hint {
        margin-top: 8px;
        font-size: 0.8rem;
        color: var(--rs-gray-dark);
    }
</style>

@if (!State.HasResults)
{
    <div class="results-page">
        <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" viewBox="0 0 16 16">
                <path d="M6 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5 6s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zM11 3.5a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1-.5-.5m.5 2.5a.5.5 0 0 0 0 1h4a.5.5 0 0 0 0-1zm2 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1zm0 3a.5.5 0 0 0 0 1h2a.5.5 0 0 0 0-1z"/>
            </svg>
            <h3>Keine Ergebnisse vorhanden</h3>
            <p>Bitte starten Sie zuerst eine Analyse auf der Startseite.</p>
            <button class="rs-button" @onclick="GoToHome" style="margin-top: 1rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/>
                    <path d="m8 3.293 6 6V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V9.293z"/>
                </svg>
                Zur Startseite
            </button>
        </div>
    </div>
}
else
{
    <div class="results-page">
        <!-- Header mit Aktionen -->
        <div class="results-header">
            <div class="results-header-content">
                <h1 class="results-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h3A1.5 1.5 0 0 1 7 2.5v3A1.5 1.5 0 0 1 5.5 7h-3A1.5 1.5 0 0 1 1 5.5zM2.5 2a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm6.5.5A1.5 1.5 0 0 1 10.5 1h3A1.5 1.5 0 0 1 15 2.5v3A1.5 1.5 0 0 1 13.5 7h-3A1.5 1.5 0 0 1 9 5.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zM1 10.5A1.5 1.5 0 0 1 2.5 9h3A1.5 1.5 0 0 1 7 10.5v3A1.5 1.5 0 0 1 5.5 15h-3A1.5 1.5 0 0 1 1 13.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5zm6.5.5A1.5 1.5 0 0 1 10.5 9h3a1.5 1.5 0 0 1 1.5 1.5v3a1.5 1.5 0 0 1-1.5 1.5h-3A1.5 1.5 0 0 1 9 13.5zm1.5-.5a.5.5 0 0 0-.5.5v3a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-3a.5.5 0 0 0-.5-.5z"/>
                    </svg>
                    Analyse-Ergebnisse
                </h1>
                <div class="button-group">
                    <button class="rs-button" @onclick="OnToggleDmsPanel" disabled="@(string.IsNullOrEmpty(State.CurrentJsonResult))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4.318 2.687c.629-.244 1.42-.387 2.282-.387s1.653.143 2.282.387c.642.249.937.555.937.813s-.295.564-.937.813c-.629.244-1.42.387-2.282.387s-1.653-.143-2.282-.387C3.676 4.064 3.381 3.758 3.381 3.5s.295-.564.937-.813M3 4.169v9.831c0 .258.295.564.937.813.629.244 1.42.387 2.282.387s1.653-.143 2.282-.387c.642-.249.937-.555.937-.813V4.169c-.355.182-.755.32-1.156.422-.74.188-1.66.293-2.063.293s-1.323-.105-2.063-.293C3.755 4.489 3.355 4.351 3 4.169"/>
                        </svg>
                        Mit DMS abgleichen
                    </button>
                    <button class="rs-button" @onclick="OnCopy" disabled="@(string.IsNullOrEmpty(State.CurrentJsonResult))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
                            <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
                        </svg>
                        Kopieren
                    </button>
                    <button class="rs-button" @onclick="OnDownloadSkill"
                            disabled="@(IsGeneratingSkill || string.IsNullOrEmpty(State.PdfTextContent))"
                            title="Erzeugt eine SKILL.md aus dem analysierten Datenblatt">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                        </svg>
                        @(IsGeneratingSkill ? "Erzeuge SKILL.md..." : "SKILL.md generieren")
                    </button>
                    <button class="rs-button" @onclick="OnReset">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466"/>
                        </svg>
                        Neue Analyse
                    </button>
                </div>
            </div>
        </div>
        
        <!-- 2-Spalten Layout -->
        <div class="results-container">
            <!-- Linke Spalte: Extrahierte Daten -->
            <div class="data-panel" id="extracted-data-panel">
                <div class="panel-header">
                    <h2 class="panel-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
                            <path d="M4.603 14.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.7 11.7 0 0 0-1.997.406 11.3 11.3 0 0 1-1.021 1.51c-.29.35-.608.655-.926.787a.8.8 0 0 1-.58.029m1.379-1.901q-.25.115-.459.238c-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361q.016.032.026.044l.035-.012c.137-.056.355-.235.635-.572a8 8 0 0 0 .45-.606m1.64-1.33a13 13 0 0 1 1.01-.193 12 12 0 0 1-.51-.858 21 21 0 0 1-.5 1.05zm2.446.45q.226.245.435.41c.24.19.407.253.498.256a.1.1 0 0 0 .07-.015.3.3 0 0 0 .094-.125.44.44 0 0 0 .059-.2.1.1 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a4 4 0 0 0-.612-.053zM8.078 7.8a7 7 0 0 0 .2-.828q.046-.282.038-.465a.6.6 0 0 0-.032-.198.5.5 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822q.036.167.09.346z"/>
                        </svg>
                        Extrahierte Daten
                    </h2>
                </div>
                <div class="panel-body">
                    <div class="data-content">@State.ResultLog</div>
                </div>

                @if (DmsTriggered)
                {
                    <div class="dms-panel">
                        <div class="dms-panel-header">
                            <h3>DMS-Abgleich</h3>
                        </div>
                        <div class="dms-panel-body">
                            <div style="display:flex; gap:12px; align-items:center; margin-bottom:12px; flex-wrap:wrap;">
                                <label style="font-weight:600; color:var(--rs-blue-header);">
                                    DMS-Materialnummer:
                                </label>
                                <input type="text"
                                       value="@MaterialNumberInput"
                                       @oninput="OnMaterialNumberChanged"
                                       @onkeypress="OnMaterialNumberKeyPress"
                                       placeholder="z.B. 1234567"
                                       style="padding:6px 10px; border:2px solid var(--rs-gray-medium); border-radius:6px; min-width:200px;" />
                                <button class="rs-button"
                                        style="background:var(--rs-blue-header); color:white; border-color:var(--rs-blue-medium);"
                                        @onclick="OnLoadFromDms"
                                        disabled="@(IsDmsLoading || string.IsNullOrWhiteSpace(MaterialNumberInput))">
                                    @(IsDmsLoading ? "Lade..." : "Aus DMS laden")
                                </button>
                                <button class="rs-button"
                                        type="button"
                                        title="Zu den extrahierten PDF-Daten springen"
                                        @onclick="ScrollToExtractedData">
                                    Extrahierte Daten anzeigen
                                </button>
                            </div>
                            @if (IsDmsLoading)
                            {
                                <div class="dms-info">DMS wird abgefragt&hellip;</div>
                            }
                            else if (!string.IsNullOrEmpty(DmsErrorMessage))
                            {
                                <div class="dms-error">@DmsErrorMessage</div>
                            }
                            else if (DmsRows != null && DmsRows.Count == 0)
                            {
                                @if (DmsRecordFound)
                                {
                                    <div class="dms-info">
                                        DMS-Datensatz fuer OBJ_ID '@DmsObjectId' gefunden, aber keine der PDF-Properties konnte auf eine DMS-Spalte gemappt werden.
                                    </div>
                                }
                                else
                                {
                                    <div class="dms-info">Kein passender DMS-Datensatz fuer OBJ_ID '@DmsObjectId' gefunden.</div>
                                }
                            }
                            else if (DmsRows != null)
                            {
                                <div style="margin-bottom:8px;">
                                    <span class="dms-info" style="display:inline-block;">
                                        OBJ_ID: <strong>@DmsObjectId</strong> &nbsp;|&nbsp;
                                        @DmsRows.Count Felder geladen &nbsp;|&nbsp;
                                        davon @DmsRows.Count(r => r.IsDifferent) Abweichungen
                                    </span>
                                    <label style="margin-left:16px;">
                                        <input type="checkbox" @bind="OnlyShowDifferences" />
                                        Nur Abweichungen anzeigen
                                    </label>
                                </div>
                                <div class="dms-table-wrapper">
                                <table class="dms-table">
                                    <thead>
                                        <tr>
                                            <th style="width:24%">DMS-Spalte</th>
                                            <th style="width:38%">Wert aus PDF-Analyse</th>
                                            <th style="width:38%">Wert aus DMS</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in GetFilteredRows())
                                        {
                                            <tr>
                                                <td><strong>@row.ColumnLabel</strong></td>
                                                <td class="@GetCellClass(row, isPdf: true)">@(row.PdfValue ?? "—")</td>
                                                <td class="@GetCellClass(row, isPdf: false)">@(row.DmsValue ?? "—")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                </div>

                                @if (DmsRawColumns != null && DmsRawColumns.Count > 0)
                                {
                                    <details style="margin-top:10px; font-size:0.8rem; color:var(--rs-gray-dark);">
                                        <summary style="cursor:pointer; font-weight:600;">
                                            Diagnose: geladene DMS-Spalten (@DmsRawColumns.Count)
                                        </summary>
                                        <div style="margin-top:6px; font-family:Consolas,monospace; word-break:break-all;">
                                            @string.Join(", ", DmsRawColumns)
                                        </div>
                                    </details>
                                }
                            }
                        </div>
                    </div>
                }

                <!-- Chatbot: Fragen zum aktuell analysierten PDF -->
                <div class="chat-panel">
                    <div class="chat-panel-header">
                        <h3>Frage zum PDF stellen</h3>
                    </div>
                    <div class="chat-panel-body">
                        @if (!PdfChat.IsAvailable)
                        {
                            <div class="chat-error-box">
                                Chatbot ist deaktiviert - Azure-Konfiguration nicht verfuegbar.
                            </div>
                        }
                        else
                        {
                            <textarea class="chat-question-input"
                                      @bind="ChatQuestion"
                                      @bind:event="oninput"
                                      @onkeydown="OnChatKeyDown"
                                      placeholder="Was möchtest du zum analysierten Datenblatt wissen? (Strg+Enter zum Senden)"
                                      disabled="@IsChatLoading"></textarea>

                            <div style="display:flex; gap:12px; align-items:center; margin-top:10px; flex-wrap:wrap;">
                                <button class="rs-button"
                                        style="background:var(--rs-blue-header); color:white; border-color:var(--rs-blue-medium);"
                                        @onclick="OnAskChat"
                                        disabled="@(IsChatLoading || string.IsNullOrWhiteSpace(ChatQuestion))">
                                    @(IsChatLoading ? "Frage wird beantwortet..." : "Frage senden")
                                </button>
                                @if (!string.IsNullOrEmpty(ChatAnswer) || !string.IsNullOrEmpty(ChatErrorMessage))
                                {
                                    <button class="rs-button" @onclick="OnClearChat" disabled="@IsChatLoading">
                                        Zuruecksetzen
                                    </button>
                                }
                                <span class="chat-hint">
                                    Antworten basieren nur auf dem aktuell analysierten PDF.
                                </span>
                            </div>

                            @if (!string.IsNullOrEmpty(ChatErrorMessage))
                            {
                                <div class="chat-error-box">@ChatErrorMessage</div>
                            }
                            else if (!string.IsNullOrEmpty(ChatAnswer))
                            {
                                <div class="chat-answer-box">@ChatAnswer</div>
                            }
                        }
                    </div>
                </div>
            </div>
            
            <!-- Rechte Spalte: Status -->
            <div class="status-panel">
                <div class="status-header">
                    <svg class="status-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                        <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533z"/>
                        <circle cx="8" cy="4.5" r="1"/>
                    </svg>
                    <h3 class="status-title">Status</h3>
                </div>
                
                <div class="status-item">
                    <div class="status-label">Aktueller Status</div>
                    <div class="status-value highlight">@State.StatusText</div>
                </div>
                
                @if (!string.IsNullOrEmpty(State.CurrentFileName))
                {
                    <div class="status-item">
                        <div class="status-label">Dateiname</div>
                        <div class="status-value">@State.CurrentFileName</div>
                    </div>
                }
                
                <div class="status-item">
                    <div class="status-label">Token-Statistik</div>
                    <div class="stat-grid">
                        <div class="stat-card">
                            <div class="stat-label">Prompt</div>
                            <div class="stat-value">@State.TotalPromptTokens.ToString("N0")</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Completion</div>
                            <div class="stat-value">@State.TotalCompletionTokens.ToString("N0")</div>
                        </div>
                    </div>
                </div>
                
                @if (State.ProcessedPdfCount > 0)
                {
                    <div class="status-item">
                        <div class="status-label">Verarbeitete PDFs</div>
                        <div class="status-value">@State.ProcessedPdfCount</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
protected override void OnInitialized()
{
    Console.WriteLine($"[Results] OnInitialized - HasResults = {State.HasResults}");
    Console.WriteLine($"[Results] ResultLog Length = {State.ResultLog?.Length ?? 0}");
    Console.WriteLine($"[Results] CurrentJsonResult Length = {State.CurrentJsonResult?.Length ?? 0}");
        
    State.OnStateChanged += OnStateChanged;
}

private void OnStateChanged()
{
    Console.WriteLine($"[Results] OnStateChanged - HasResults = {State.HasResults}");
    InvokeAsync(StateHasChanged);
}

    private async Task OnCopy()
    {
        if (string.IsNullOrEmpty(State.CurrentJsonResult)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", State.CurrentJsonResult);
            State.StatusText = "? In Zwischenablage kopiert";
        }
        catch
        {
            State.StatusText = "? Kopieren fehlgeschlagen";
        }
        StateHasChanged();
    }

    private void OnReset()
    {
        State.Reset();
        GoToHome();
    }

    private bool IsGeneratingSkill;

    /// <summary>
    /// Erzeugt eine SKILL.md aus dem analysierten PDF-Text und triggert
    /// direkt einen Browser-Download. Kein Server-seitiges Speichern.
    /// </summary>
    private async Task OnDownloadSkill()
    {
        if (IsGeneratingSkill) return;
        if (string.IsNullOrWhiteSpace(State.PdfTextContent))
        {
            State.StatusText = "Kein PDF-Text vorhanden fuer SKILL.md.";
            return;
        }

        IsGeneratingSkill = true;
        State.StatusText = "SKILL.md wird erzeugt...";
        StateHasChanged();

        try
        {
            string markdown = await AnalysisService.GenerateSkillMarkdownAsync(State.PdfTextContent!);
            string frontMatter = BuildFrontMatter();
            string full = frontMatter + markdown.TrimStart();

            string fileName = BuildSkillFileName();
            await JS.InvokeVoidAsync("downloadFile", fileName, "text/markdown", full);

            State.StatusText = $"SKILL.md '{fileName}' heruntergeladen.";
        }
        catch (Exception ex)
        {
            State.StatusText = "Fehler beim Erzeugen der SKILL.md: " + ex.Message;
        }
        finally
        {
            IsGeneratingSkill = false;
            StateHasChanged();
        }
    }

    private string BuildFrontMatter()
    {
        string? partNumber = null, manufacturer = null, componentType = null,
                function = null, packageType = null, description = null;

        if (!string.IsNullOrWhiteSpace(State.CurrentJsonResult))
        {
            try
            {
                var j = JObject.Parse(State.CurrentJsonResult);
                partNumber    = j["PartNumber"]?.Value<string>();
                manufacturer  = j["Manufacturer"]?.Value<string>() ?? j["ManufacturerInfo"]?.Value<string>();
                componentType = j["ComponentType"]?.Value<string>() ?? j["ComponentCategory"]?.Value<string>();
                function      = j["Function"]?.Value<string>();
                packageType   = j["PackageType"]?.Value<string>();
                description   = j["Description"]?.Value<string>();
            }
            catch { /* ignore */ }
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("---");
        sb.AppendLine($"generated_at: {DateTime.UtcNow:yyyy-MM-ddTHH:mm:ssZ}");
        sb.AppendLine($"source_file: {YamlEscape(State.CurrentFileName)}");
        if (!string.IsNullOrWhiteSpace(partNumber))    sb.AppendLine($"part_number: {YamlEscape(partNumber)}");
        if (!string.IsNullOrWhiteSpace(manufacturer))  sb.AppendLine($"manufacturer: {YamlEscape(manufacturer)}");
        if (!string.IsNullOrWhiteSpace(componentType)) sb.AppendLine($"component_type: {YamlEscape(componentType)}");
        if (!string.IsNullOrWhiteSpace(function))      sb.AppendLine($"function: {YamlEscape(function)}");
        if (!string.IsNullOrWhiteSpace(packageType))   sb.AppendLine($"package_type: {YamlEscape(packageType)}");
        if (!string.IsNullOrWhiteSpace(description))   sb.AppendLine($"description: {YamlEscape(description)}");
        sb.AppendLine("---");
        sb.AppendLine();
        return sb.ToString();
    }

    private static string YamlEscape(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "\"\"";
        return "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
    }

    private string BuildSkillFileName()
    {
        string? partNumber = null;
        if (!string.IsNullOrWhiteSpace(State.CurrentJsonResult))
        {
            try { partNumber = JObject.Parse(State.CurrentJsonResult)["PartNumber"]?.Value<string>(); }
            catch { }
        }

        string baseName = !string.IsNullOrWhiteSpace(partNumber)
            ? partNumber!
            : System.IO.Path.GetFileNameWithoutExtension(State.CurrentFileName ?? "datasheet");

        foreach (char c in System.IO.Path.GetInvalidFileNameChars())
            baseName = baseName.Replace(c, '_');

        return baseName + ".SKILL.md";
    }

    private void GoToHome()
    {
        Navigation.NavigateTo("/", false);
    }

    public void Dispose()
    {
        State.OnStateChanged -= OnStateChanged;
    }

    // ---------- DMS-Abgleich ----------

    private enum DmsRowStatus { Match, Different, OnlyInPdf, OnlyInDms }

    private record DmsRow(string ColumnLabel, string? PdfValue, string? DmsValue, DmsRowStatus Status)
    {
        public bool IsDifferent => Status != DmsRowStatus.Match;
    }

    private bool DmsTriggered;
    private bool IsDmsLoading;
    private string? DmsErrorMessage;
    private string? DmsObjectId;
    private bool DmsRecordFound;
    private string MaterialNumberInput = "";
    private List<DmsRow>? DmsRows;
    private List<string>? DmsRawColumns;
    private bool OnlyShowDifferences = false;

    /// <summary>
    /// Empty markers, die im PDF-Analyse-Ergebnis als "kein Wert" gelten.
    /// Werden beim Diff wie NULL behandelt, damit "nicht vorhanden" vs. DMS-NULL
    /// nicht als Abweichung gewertet wird.
    /// </summary>
    private static readonly string[] EmptyMarkers =
    {
        "nicht vorhanden", "nicht gefunden", "nicht klar erkennbar",
        "mehrdeutig", "nicht relevant", "n/a", "-"
    };

    /// <summary>
    /// PDF-Properties, die vom DMS-Diff ausgeschlossen werden. Entweder gibt
    /// es keine direkt vergleichbare DMS-Spalte (Funktion steckt im DMS
    /// implizit in der Kataloggruppe SKN_COD, nicht als Klartext) oder der
    /// Wert wird bereits ueber die Materialnummer selbst identifiziert
    /// (PartNumber, Manufacturer, Description). Diese Properties im UI zu
    /// zeigen wuerde nur Dauer-"+"-Eintraege ohne Erkenntniswert erzeugen.
    /// </summary>
    private static readonly HashSet<string> NonComparableProperties =
        new(StringComparer.OrdinalIgnoreCase)
        {
            "Function",
            "ComponentType",
            "ComponentCategory",
            "Manufacturer",
            "ManufacturerInfo",
            "Description",
            "PartNumber"
        };

    /// <summary>
    /// Synonym-Mapping PDF-Property -> moegliche DMS-Spaltennamen.
    /// Wird nur als letzter Fallback verwendet, wenn weder PropertyMap
    /// (ORDNUM-Join) noch der normalisierte Namensvergleich einen
    /// Treffer liefern. Bewusst konservativ gehalten.
    /// </summary>
    private static readonly Dictionary<string, string[]> PropertySynonyms =
        new(StringComparer.OrdinalIgnoreCase)
        {
            ["Function"]     = new[] { "TF", "FUNKTION", "FUNCTION", "FKT", "FUNC" },
            ["SrfHz"]        = new[] { "FSRF", "SRF", "FREQU_SRF", "FREQU___SRF", "F_SRF", "SRF_HZ", "FRSRF" },
            ["TolerancePct"] = new[] { "TOLERANCE", "TOL", "TOLERANZ", "TOLERANCE_PERCENT" },
            ["Surface3"]     = new[] { "OFL", "SURFACE", "OBERFLAECHE", "OBERFL", "OFL_3" },
            ["FrequencyQ"]   = new[] { "FREQU_Q", "FREQU___Q", "F_Q", "FQ", "FREQU", "FRQ" },
            ["QualityFacQ"]  = new[] { "QFAK", "QFACTOR", "Q_FAK", "GUETE", "QGUETE", "QVAL" },
            ["IrmsA"]        = new[] { "IRMS", "I_RMS", "IRMS_A", "STROM_RMS" },
            ["IsatA"]        = new[] { "ISAT", "I_SAT", "ISAT_A", "STROM_SAT" },
            // --- RF Amplifier ---
            ["FMinHz"]       = new[] { "FMIN", "F_MIN", "FREQU_MIN", "FREQU___MIN", "FRQMIN" },
            ["FMaxHz"]       = new[] { "FMAX", "F_MAX", "FREQU_MAX", "FREQU___MAX", "FRQMAX" },
            ["GainTypDb"]    = new[] { "GAIN", "GAIN_TYP", "VERSTAERKUNG", "GVR", "GTYP" },
            ["NfTypDb"]      = new[] { "NF", "NF_TYP", "NOISE", "RAUSCHZAHL", "NFDB" },
            ["Op1DbDbm"]     = new[] { "OP1DB", "P1DB", "P_1DB", "OUTP1DB", "OP1DB_DBM" },
            ["Oip3TypDbm"]   = new[] { "OIP3", "IP3", "OIP3_TYP", "OIP3_DBM", "OIP3_TYP_DBM" },
            ["IsupplyMaxA"]  = new[] { "ISUP", "ISUPPLY", "I_SUP", "IDD", "ICC", "STROM_MAX", "IMAX" },
            ["PdissW"]       = new[] { "PDISS", "P_DISS", "PD", "POWER_DISS", "PDIS" },
            ["NumberOfPin"]  = new[] { "PINS", "PIN_ANZ", "ANZ_PINS", "NR_PINS", "PIN" },
        };

    private async Task ScrollToExtractedData()
    {
        try
        {
            // Robuster als eval: nutzt Standard-Browser-Anker.
            // Falls window.scrollTo per JS-Interop verfuegbar ist, direkt anspringen.
            await JS.InvokeVoidAsync("scrollToElementById", "extracted-data-panel");
        }
        catch
        {
            try
            {
                // Fallback ueber Anker-Navigation.
                Navigation.NavigateTo(Navigation.Uri.Split('#')[0] + "#extracted-data-panel", forceLoad: false);
            }
            catch { /* ignore */ }
        }
    }

    private void OnToggleDmsPanel()
    {
        DmsTriggered = true;
        // Bei erstem Oeffnen: Materialnummer-Vorschlag aus Analyse-JSON ziehen,
        // falls dort z.B. eine interne Sachnummer extrahiert wurde.
        if (string.IsNullOrWhiteSpace(MaterialNumberInput) && !string.IsNullOrEmpty(State.CurrentJsonResult))
        {
            try
            {
                var json = JObject.Parse(State.CurrentJsonResult);
                MaterialNumberInput = json["MaterialNumber"]?.Value<string>()
                                   ?? json["Sachnummer"]?.Value<string>()
                                   ?? "";
            }
            catch { /* ignore */ }
        }
        StateHasChanged();
    }

    private void OnMaterialNumberChanged(ChangeEventArgs e)
    {
        MaterialNumberInput = e.Value?.ToString() ?? "";
    }

    private async Task OnMaterialNumberKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsDmsLoading && !string.IsNullOrWhiteSpace(MaterialNumberInput))
        {
            await OnLoadFromDms();
        }
    }

    private string? ExtractCategoryFromResult()
    {
        if (string.IsNullOrWhiteSpace(State.CurrentJsonResult)) return null;
        try
        {
            var j = JObject.Parse(State.CurrentJsonResult);
            return j["ComponentType"]?.Value<string>()
                ?? j["ComponentCategory"]?.Value<string>();
        }
        catch { return null; }
    }

    private async Task OnLoadFromDms()
    {
        DmsErrorMessage = null;
        DmsRows = null;
        DmsRecordFound = false;
        IsDmsLoading = true;
        StateHasChanged();

        try
        {
            if (!DmsLookup.IsConfigured)
            {
                DmsErrorMessage = "DMS-Anbindung ist nicht vollst\u00e4ndig konfiguriert " +
                                  "(DmsOracle:Host/ServiceName/User/Password in appsettings.json pruefen).";
                return;
            }

            if (string.IsNullOrWhiteSpace(MaterialNumberInput))
            {
                DmsErrorMessage = "Bitte eine DMS-Materialnummer eingeben.";
                return;
            }

            var result = await DmsLookup.GetMaterialInfoAsync(MaterialNumberInput.Trim(), ExtractCategoryFromResult());
            DmsObjectId = result.ObjectId;

            if (!string.IsNullOrEmpty(result.ErrorMessage))
            {
                DmsErrorMessage = result.ErrorMessage;
                return;
            }

            if (!result.Found)
            {
                DmsRows = new List<DmsRow>();
                return;
            }

            DmsRecordFound = true;

            // PDF-Properties (analog Spaltennamen) einlesen.
            var pdfProps = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrEmpty(State.CurrentJsonResult))
            {
                try
                {
                    var json = JObject.Parse(State.CurrentJsonResult);
                    foreach (var prop in json.Properties())
                    {
                        if (prop.Name.StartsWith("_", StringComparison.Ordinal)) continue;
                        // Nicht vergleichbare Meta-Properties ausblenden:
                        // "Function", "ComponentType", "ComponentCategory",
                        // "ManufacturerInfo", "Manufacturer", "Description",
                        // "PartNumber" sind entweder Klartext-Beschreibungen
                        // ohne aequivalente DMS-Spalte (Funktion steckt im DMS
                        // implizit in der Kataloggruppe SKN_COD) oder werden
                        // ueber die Materialnummer selbst schon eindeutig
                        // identifiziert. Sie im Diff zu zeigen produziert nur
                        // Dauer-"+"-Eintraege ohne Erkenntniswert.
                        if (NonComparableProperties.Contains(prop.Name)) continue;
                        pdfProps[prop.Name] = prop.Value?.ToString();
                    }
                }
                catch (Exception ex)
                {
                    DmsErrorMessage = $"Analyse-Ergebnis konnte nicht als JSON gelesen werden: {ex.Message}";
                    return;
                }
            }

            // WICHTIG: Wir iterieren NUR ueber die PDF-Properties (= das, was die
            // Analyse extrahiert hat). DMS hat viele zusaetzliche interne Spalten
            // (CHECK_*, BEARBEITER, BA, ...), die fuer einen Property-Abgleich
            // irrelevant sind und das UI vollkommen ueberfluten wuerden.
            // PDF-Properties, die im DMS gar nicht vorkommen, werden ebenfalls
            // gefiltert (sonst sieht der User lauter "+ OnlyInPdf"-Zeilen ohne
            // Erkenntniswert).
            //
            // DMS-Spaltennamen weichen haeufig von den PDF-Property-Namen ab
            // (z.B. PDF "Pitch" vs. DMS "PITCH___1", "GEH_TYP1" vs. "Package").
            // Wir bauen deshalb einen normalisierten Index ueber die DMS-Spalten
            // und akzeptieren zusaetzlich Praefix-Matches.
            static string NormKey(string s)
            {
                // Alles in eckigen Klammern (typischerweise Einheiten wie "[mm]",
                // "[H]", "[Ohm]", "[%]") komplett entfernen, damit PDF-Property
                // "Hoehe [mm]" auf DMS-Spalte "HEIGHT" mappen kann.
                var noUnit = System.Text.RegularExpressions.Regex.Replace(s, @"\[[^\]]*\]", "");
                var sb = new System.Text.StringBuilder(noUnit.Length);
                foreach (var c in noUnit)
                    if (char.IsLetterOrDigit(c)) sb.Append(char.ToUpperInvariant(c));
                // fuehrende/trailende Zahlen entfernen (PITCH___1 -> PITCH)
                int end = sb.Length;
                while (end > 0 && char.IsDigit(sb[end - 1])) end--;
                return sb.ToString(0, end);
            }

            var dmsIndex = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            // 1) Zuerst alle gefuellten Spalten indizieren (haben Vorrang).
            foreach (var kv in result.Values)
            {
                var norm = NormKey(kv.Key);
                if (norm.Length == 0) continue;
                if (!dmsIndex.ContainsKey(norm))
                    dmsIndex[norm] = kv.Key;
            }
            // 2) Danach ALLE Spalten (auch NULL-Spalten) indizieren, damit auch
            //    leere DMS-Felder als Ziel eines Property-Matches erkannt werden.
            if (result.AllColumns != null)
            {
                foreach (var col in result.AllColumns)
                {
                    var norm = NormKey(col);
                    if (norm.Length == 0) continue;
                    if (!dmsIndex.ContainsKey(norm))
                        dmsIndex[norm] = col;
                }
            }

            // Diagnose-Ausgabe: alle geladenen DMS-Spaltennamen (sortiert)
            DmsRawColumns = result.Values.Keys
                .Concat(result.AllColumns ?? Enumerable.Empty<string>())
                .Where(k => !string.IsNullOrWhiteSpace(k))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(k => k, StringComparer.OrdinalIgnoreCase)
                .ToList();

            // 3) Alias-Mapping: keine hartcodierte Liste mehr - die Kopplung
            //    PDF-Property -> DMS-Spalte kommt jetzt dynamisch ueber
            //    DmsLookupResult.PropertyMap (ORDNUM-Join TR_SMT/TE_CLS_MERK
            //    x get_classes.csv).

            var rows = new List<DmsRow>();
            foreach (var key in pdfProps.Keys.OrderBy(k => k, StringComparer.OrdinalIgnoreCase))
            {
                string? dmsKey = null;

                // 1) Bevorzugt: explizites Mapping aus TE_CLS_MERK (PropertyMap).
                if (result.PropertyMap != null &&
                    result.PropertyMap.TryGetValue(key, out var mappedCol) &&
                    !string.IsNullOrWhiteSpace(mappedCol))
                {
                    dmsKey = mappedCol;
                }

                // 2) Fallback: Namensmatch (normalisiert) gegen alle DMS-Spalten,
                //    damit Merkmale wie Function/TolerancePct/SrfHz auch dann
                //    erscheinen, wenn die ORDNUM-Kopplung nicht greift.
                if (dmsKey is null)
                {
                    var norm = NormKey(key);
                    if (norm.Length > 0 && dmsIndex.TryGetValue(norm, out var byName))
                    {
                        dmsKey = byName;
                    }
                }

                // 3) Remote-konfiguriertes Alias-Mapping aus Azure Blob
                //    (dms_property_map.json). Wird ohne Code-Aenderung
                //    ueber den RemoteConfigService gepflegt.
                if (dmsKey is null)
                {
                    var category = ExtractCategoryFromResult();
                    foreach (var alias in DmsPropertyMap.GetAliases(category, key))
                    {
                        var normAlias = NormKey(alias);
                        if (normAlias.Length == 0) continue;
                        if (dmsIndex.TryGetValue(normAlias, out var byAlias))
                        {
                            dmsKey = byAlias;
                            break;
                        }
                    }
                }

                // 4) Synonym-Fallback: eingebauter Katalog bekannter Aliase.
                //    Wird nur genutzt, wenn (1)-(3) nichts gefunden haben.
                if (dmsKey is null && PropertySynonyms.TryGetValue(key, out var synonyms))
                {
                    foreach (var syn in synonyms)
                    {
                        var normSyn = NormKey(syn);
                        if (normSyn.Length == 0) continue;
                        if (dmsIndex.TryGetValue(normSyn, out var bySyn))
                        {
                            dmsKey = bySyn;
                            break;
                        }
                    }
                }

                if (dmsKey is null)
                {
                    // Kein DMS-Match: PDF-Property gehoert nicht zu den
                    // Technischen Parametern dieser Kataloggruppe -> ausblenden.
                    continue;
                }

                string? pdfRaw = pdfProps[key];
                string? dmsRaw = result.Values.TryGetValue(dmsKey, out var dv) ? dv : null;

                bool pdfEmpty = IsEmpty(pdfRaw);
                bool dmsEmpty = IsEmpty(dmsRaw);

                if (pdfEmpty && dmsEmpty)
                    continue; // beide leer -> uninteressant

                DmsRowStatus status;
                if (pdfEmpty)
                    status = DmsRowStatus.OnlyInDms;
                else if (dmsEmpty)
                    status = DmsRowStatus.OnlyInPdf;
                else if (string.Equals(NormalizeValue(pdfRaw), NormalizeValue(dmsRaw), StringComparison.OrdinalIgnoreCase)
                         || NumericEqual(pdfRaw, dmsRaw))
                    status = DmsRowStatus.Match;
                else
                    status = DmsRowStatus.Different;

                rows.Add(new DmsRow(key, pdfRaw, dmsRaw, status));
            }

            DmsRows = rows;
        }
        catch (Exception ex)
        {
            DmsErrorMessage = $"Fehler beim DMS-Abgleich: {ex.Message}";
        }
        finally
        {
            IsDmsLoading = false;
            StateHasChanged();
        }
    }

    private IEnumerable<DmsRow> GetFilteredRows()
    {
        if (DmsRows == null) yield break;
        foreach (var r in DmsRows)
        {
            if (OnlyShowDifferences && r.Status == DmsRowStatus.Match) continue;
            yield return r;
        }
    }

    private static string GetCellClass(DmsRow row, bool isPdf) => row.Status switch
    {
        DmsRowStatus.Match     => "dms-cell-match",
        DmsRowStatus.Different => "dms-cell-diff",
        DmsRowStatus.OnlyInPdf => isPdf ? "dms-cell-diff" : "",
        DmsRowStatus.OnlyInDms => isPdf ? "" : "dms-cell-diff",
        _ => ""
    };

    private static bool IsEmpty(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return true;
        var t = v.Trim();
        return EmptyMarkers.Any(m => string.Equals(t, m, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// Normalisiert Whitespace inklusive Unicode-Spezialzeichen (NBSP etc.),
    /// damit "2 GHz" und "2\u00A0GHz" nicht als Unterschied gewertet werden.
    /// </summary>
    private static string NormalizeValue(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return "";
        var sb = new System.Text.StringBuilder(v.Length);
        foreach (var ch in v)
        {
            if (ch == '\u00A0' || ch == '\u202F' || ch == '\u2007' || ch == '\u2009'
                || ch == '\u200B' || ch == '\u200C' || ch == '\u200D' || ch == '\uFEFF')
                sb.Append(' ');
            else
                sb.Append(ch);
        }
        return System.Text.RegularExpressions.Regex.Replace(sb.ToString(), @"\s+", " ").Trim();
    }

    /// <summary>
    /// Vergleicht zwei Werte numerisch mit Einheiten-Skalierung.
    /// Beispiele die als gleich erkannt werden:
    ///   "27 µH" vs "2.7E-05"          (µ = 1e-6)
    ///   "15 MHz" vs "15000000"        (M = 1e6)
    ///   "100 kHz" vs "100000"         (k = 1e3)
    ///   "37.6 m?" vs "0.0376"         (m = 1e-3)
    ///   "±20%" vs "20"                (Vorzeichen/Prozent ignoriert)
    ///   "4.3 A" vs "4,3"              (Dezimalkomma vs Punkt)
    ///   "6.4 mm" vs "6,4"             (Einheit ignoriert)
    /// </summary>
    private static bool NumericEqual(string? a, string? b)
    {
        if (a is null || b is null) return false;
        if (!TryParseWithUnit(a, out var av)) return false;
        if (!TryParseWithUnit(b, out var bv)) return false;
        if (av == 0 && bv == 0) return true;
        double diff = Math.Abs(av - bv);
        double scale = Math.Max(Math.Abs(av), Math.Abs(bv));
        return diff <= scale * 1e-3; // 0.1% Toleranz
    }

    private static bool TryParseWithUnit(string? s, out double value)
    {
        value = 0;
        if (string.IsNullOrWhiteSpace(s)) return false;
        var t = s.Trim().TrimStart('±', '+', '~').Replace("\u00A0", " ").Trim();
        // Zahlen-Teil (mit optionalem Vorzeichen, Dezimalpunkt/komma, Exponent) extrahieren
        var m = System.Text.RegularExpressions.Regex.Match(
            t, @"^\s*(-?\d+(?:[.,]\d+)?(?:[eE][-+]?\d+)?)\s*([^\s]*)");
        if (!m.Success) return false;
        var num = m.Groups[1].Value.Replace(',', '.');
        if (!double.TryParse(num, System.Globalization.NumberStyles.Float,
                System.Globalization.CultureInfo.InvariantCulture, out value))
            return false;

        var unit = m.Groups[2].Value.Trim();
        // SI-Praefix am Anfang der Einheit auswerten. Nur wenn danach eine
        // Einheit folgt (Hz, H, ?, A, V, W, F, s, m, g, ...), damit "mm" nicht
        // faelschlich als "milli-m" skaliert wird.
        double factor = 1.0;
        if (unit.Length >= 2)
        {
            char p = unit[0];
            string rest = unit.Substring(1);
            double? f = p switch
            {
                'T' => 1e12,
                'G' => 1e9,
                'M' => 1e6,
                'k' or 'K' => 1e3,
                'm' => 1e-3,
                'µ' or 'u' or '?' => 1e-6,
                'n' => 1e-9,
                'p' => 1e-12,
                _ => (double?)null
            };
            // "mm" bleibt Millimeter (unskaliert), aber "m?" ist Milli-Ohm.
            if (f.HasValue && rest.Length > 0 && rest != "m")
                factor = f.Value;
        }
        value *= factor;
        return true;
    }

    // ---------- Chatbot: Fragen zum PDF ----------

    private string ChatQuestion = "";
    private string? ChatAnswer;
    private string? ChatErrorMessage;
    private bool IsChatLoading;

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        // Strg+Enter (oder Cmd+Enter auf macOS) sendet die Frage.
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)
            && !IsChatLoading && !string.IsNullOrWhiteSpace(ChatQuestion))
        {
            await OnAskChat();
        }
    }

    private async Task OnAskChat()
    {
        if (IsChatLoading || string.IsNullOrWhiteSpace(ChatQuestion)) return;

        ChatErrorMessage = null;
        ChatAnswer = null;
        IsChatLoading = true;
        StateHasChanged();

        try
        {
            // Bewusst nur EINE aktuelle Frage/Antwort - keine Historie.
            string answer = await PdfChat.AskAsync(
                State.PdfTextContent,
                State.CurrentJsonResult,
                ChatQuestion.Trim());

            ChatAnswer = string.IsNullOrWhiteSpace(answer)
                ? "(Keine Antwort erhalten.)"
                : answer;
        }
        catch (Exception ex)
        {
            ChatErrorMessage = $"Fehler beim Beantworten: {ex.Message}";
        }
        finally
        {
            IsChatLoading = false;
            StateHasChanged();
        }
    }

    private void OnClearChat()
    {
        ChatQuestion = "";
        ChatAnswer = null;
        ChatErrorMessage = null;
    }
}
